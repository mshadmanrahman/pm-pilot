{
  "name": "pm-pilot",
  "description": "PM Pilot: product management skills for Claude Code, written to the standard Agent Skills format. Discovery with verified quotes, PRDs, prioritization, meeting prep, stakeholder comms.",
  "owner": {
    "name": "Shadman Rahman",
    "url": "https://github.com/mshadmanrahman"
  },
  "plugins": [
    {
      "name": "pm-discovery",
      "source": "./plugins/pm-discovery",
      "displayName": "PM Discovery",
      "description": "Customer discovery that does not invent quotes. Turns one interview into a structured snapshot with every quote verified against the transcript, then runs the full cycle: frame, interview, synthesize, package.",
